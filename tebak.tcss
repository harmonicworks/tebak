/* 테박 — Textual CSS */

Screen {
    background: #1a1a1a;
    color: #cccccc;
    layers: base overlay;
}

#status-bar {
    height: 1;
    background: #111111;
    color: #aaaaaa;
    border-bottom: solid #333333;
    layer: base;
}

#main-container {
    height: 1fr;
    background: #1a1a1a;
    layer: base;
}

#tracks-container {
    width: 1fr;
    padding: 1 2;
    layout: vertical;
    background: #1a1a1a;
}

TrackRow {
    height: 4;
    margin-bottom: 1;
    background: #1a1a1a;
    color: #cccccc;
}

#reel {
    width: 26;
    background: #111111;
    border-left: solid #333333;
    padding: 1 1;
    align: center middle;
    color: #d08020;
}

#transport {
    height: 3;
    background: #111111;
    border-top: solid #333333;
    color: #aaaaaa;
    layer: base;
}

MidiSelector {
    layer: overlay;
    align: center middle;
    width: 70;
    height: 20;
    background: #1e1e1e;
    border: solid #e8a020;
    padding: 1 2;
}

FileInput {
    layer: overlay;
    align: center middle;
    width: 64;
    height: 7;
    background: #1e1e1e;
    border: solid #666666;
    padding: 1 2;
}

#file-prompt {
    color: #e8a020;
    margin-bottom: 1;
}

Input {
    background: #111111;
    border: solid #555555;
    color: #cccccc;
}

Input:focus {
    border: solid #e8a020;
}
